# Site URL (used for SEO, sitemap, absolute URLs)
NEXT_PUBLIC_SITE_URL=https://decosol.pl

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google reCAPTCHA Keys
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Optional: Google reCAPTCHA Enterprise (ustaw na 'true' aby włączyć)
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_ENABLED=false
# RECAPTCHA_ENTERPRISE_PROJECT_ID=your_project_id
# RECAPTCHA_ENTERPRISE_SITE_KEY=your_enterprise_site_key

# Optional: Beehiiv Newsletter
# BEEHIIV_API_KEY=your_beehiiv_key
# BEEHIIV_PUBLICATION_ID=your_publication_id

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-G0KX4ZHEMB
